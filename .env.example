# Backend environment — EasyPanel / production

APP_ENV=production
APP_CORS_ORIGINS=https://sunuyaram.shop,https://www.sunuyaram.shop
API_BASE_URL=https://api.sunuyaram.shop

# PostgreSQL (EasyPanel internal)
DATABASE_URL=postgres://sunuyaram:sunuyaram@sunuyaram_sunuyaram:5432/sunuyaram?sslmode=disable

# Google Sheets webhook (Apps Script deploy URL)
GOOGLE_SHEETS_WEBHOOK_URL=

# MaxMind GeoIP2 / minFraud
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_STRICT_MODE=true

# Test phone — bypass geo block (comma-separated, 10 digits)
PHONE_WHITELIST=0550000000

# Meta Conversions API
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# TikTok Events API
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Snapchat Conversions API
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=

# Rate limiting
ORDER_RATE_LIMIT_PER_PHONE_24H=3
